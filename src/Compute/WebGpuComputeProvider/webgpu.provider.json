{
  "providerId": "webgpu.compute",
  "name": "WebGPU Compute",
  "version": "0.1.3",
  "assembly": "WebGpuComputeProvider.dll",
  "capabilities": [
    "compute.dispatch",
    "compute.vector_add",
    "gpu.hud.composite",
    "gpu.aisthesis.raw-frame",
    "gpu.spatial-reasoning",
    "gpu.zero-copy.raw-texture"
  ],
  "metadata": {
    "adapterProfile": "webgpu-browser",
    "backend": "browser-webgpu",
    "fallback": "cpu",
    "rev3": "true",
    "rawCaptureSource": "raw-framebuffer",
    "passBridge": "optional-native-or-js",
    "gpuBypass": "raw-texture-binding",
    "nativeJsBridge": "rev3-envelope-bridge",
    "aotCompilerHooks": "planned-gpu-native-execution",
    "deterministicFrameSampling": "frame-token-index-sample-ticks",
    "zeroCopyBufferHandling": "raw-framebuffer-texture",
    "hudComposite": "gpu",
    "aisMatrixOrder": "topos,route,threat,zoe",
    "rev3EnvelopeBridge": "runtime/browser/webgpu-rev3-envelope-bridge.js",
    "rev3EnvelopeSchema": "aikernel.gpu.rev3.dispatch",
    "rev3EnvelopeBridgeFactory": "createWebGpuRev3EnvelopeBridge",
    "rev3EnvelopeBridgeExecutorFactory": "createWebGpuRev3BrowserExecutor",
    "rev3EnvelopeBridgeGlobal": "AIKernelWebGpuRev3",
    "rev3BrowserPassReadiness": "Passes.{Aisthesis,SpatialReasoning,HudComposite}:ShaderBound,PipelineCached,BuiltInExecutor,InjectedExecutor,ReadyForBuiltIn",
    "providerType": "AIKernel.Wasm.Comput.WebGpuComputeProvider",
    "invokerType": "AIKernel.Wasm.Comput.WebGpuComputeInvoker"
  },
  "cli": {
    "command": "gpu",
    "defaultOperation": "compute.vector_add",
    "configKeys": [
      "adapterProfile",
      "backend",
      "forceCpuFallback"
    ],
    "requiredEnvironment": []
  }
}
