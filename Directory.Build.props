<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <StablePackageVersion>0.1.1.1</StablePackageVersion>
    <LocalPackageVersionPrefix>0.1.1.1</LocalPackageVersionPrefix>
    <LocalPackageBuildNumber Condition="'$(LocalPackageBuildNumber)' == ''">0</LocalPackageBuildNumber>
    <UseLocalPackageVersion Condition="'$(UseLocalPackageVersion)' == ''">false</UseLocalPackageVersion>
    <PackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</PackageVersion>
    <PackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>$(StablePackageVersion)</AssemblyVersion>
    <FileVersion>$(StablePackageVersion)</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <AIKernelPackageVersion>[0.1.1.1]</AIKernelPackageVersion>
    <AIKernelCorePackageVersion>0.1.1.1-dev1</AIKernelCorePackageVersion>
    <AIKernelProvidersPackageVersion>[0.1.1.1-dev2]</AIKernelProvidersPackageVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>Takuya Sogawa</Authors>
    <Company>AIKernel-NET</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://www.nuget.org/profiles/AIKernel-NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIKernel-NET/AIKernel.Wasm</RepositoryUrl>
    <Copyright>Copyright © 2026 Takuya Sogawa of AIKernel-NET</Copyright>
    <PackageTags>aikernel;wasm;webgpu;browser;runtime;process;memory;stdin;filesystem;event;audio;screenshot;savestate;time</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>AIKernel.Wasm runtime isolation package family v0.1.1.1 for browser/WASM runtime services and WebGPU compute boundaries. This package line is NuGet-only.</Description>
    <PackageReleaseNotes>
      AIKernel.Wasm v0.1.1.1 - Development line aligned with AIKernel.NET contract packages v0.1.1.1, local AIKernel.Core package family v0.1.1.1-dev{build-number}, and local AIKernel.Providers package family v0.1.1.1-dev{build-number}. This line is NuGet-only and uses 0.1.1.1-dev{build-number} for local development package outputs.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)README-ja.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
